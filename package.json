{
  "name": "dramatis",
  "version": "0.0.0",
  "private": true,
  "description": "An open 3D character creator for the web: CC0 base data, GLB and VRM out, works in any engine.",
  "license": "Apache-2.0",
  "homepage": "https://dramatis.tosijs.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonioloewald/dramatis3d.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "bun bin/site.ts",
    "build": "bun bin/site.ts --build",
    "stop": "bun bin/site.ts --stop",
    "tunnel": "TOSIJS_SITE_CONFIG=site/config.ts tosijs-tunnel",
    "tls": "tosijs-dev-certs",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "format": "bun --bun prettier --cache --write .",
    "format:check": "bun --bun prettier --check .",
    "check": "bun run typecheck && bun run format:check && bun test",
    "gate1": "bun test test/gate1",
    "test-consumer": "bun bin/pack-smoke.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tosijs-3d": "0.11.6"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "^9.16.2",
    "@babylonjs/gui": "^9.16.2",
    "@babylonjs/loaders": "^9.16.2",
    "@babylonjs/materials": "^9.16.2",
    "@pixiv/three-vrm": "3.5.5",
    "@types/bun": "latest",
    "@types/three": "^0.186.0",
    "chokidar": "^4.0.3",
    "fake-indexeddb": "6.0.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.63.0",
    "prettier": "^2.8.8",
    "three": "^0.186.1",
    "tosijs": "^1.10.7",
    "tosijs-ui": "^1.16.38",
    "typescript": "^5.9.3"
  },
  "releaseDoctor": {
    "securityEntries": [
      "src/share/index.ts",
      "site/viewer/main.ts"
    ],
    "buildOutputs": [
      "dist"
    ]
  }
}
