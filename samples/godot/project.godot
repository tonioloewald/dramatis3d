; Dramatis Godot sample: imports exported characters and plays a UAL clip.
; Godot 4.5. Checked headless by tools/engines/godot.ts; open it in the editor
; to look (res://main.tscn walks the first character in characters/).

config_version=5

[application]

config/name="Dramatis sample"
config/description="An exported Dramatis character playing Quaternius' UAL Walk_Loop (CC0)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[rendering]

renderer/rendering_method="mobile"
